{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "sourceMap": true,
    "noEmit": false,
    "lib": ["dom", "dom.iterable", "es2020"],
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@safeview/shared/*": ["../../libs/shared/src/*"],
      "@safeview/backend/*": ["../../apps/backend/src/*"],
      "@safeview/tv-app/*": ["apps/tv-app/src/*"]
    }
  },
  "include": ["src/**/*", "../../libs/shared/src/**/*"],
  
} 